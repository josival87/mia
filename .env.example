# Copie para .env e preencha. Em produção use: docker compose -f docker-compose.prod.yml up -d --build
# Nenhum segredo abaixo tem valor padrão em produção: o compose se recusa a subir se faltar algum.

APP_URL=https://jbmj.io/mia
# Gere com: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
# Ao trocar uma APP_KEY antiga, coloque a anterior aqui até regravar as chaves cifradas no admin, depois apague.
APP_PREVIOUS_KEYS=
APP_PORT=18088
DB_PASSWORD=

SESSION_PATH=/mia
TELEGRAM_WEBHOOK_URL=https://jbmj.io/mia/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

MIA_ADMIN_EMAIL=admin@jbmj.io
# Mínimo de 12 caracteres; Mia@12345 é recusada em produção.
MIA_ADMIN_PASSWORD=

ALUGAPRO_FINANCE_API_KEY=
DASHPAY_FINANCE_API_KEY=

# ---- Serviço de IA (Go) ----
# Token compartilhado Laravel <-> Go, 32+ caracteres. Gere com: openssl rand -hex 32
COGNITION_INTERNAL_TOKEN=
# Mensagens interpretadas por IA por usuário por dia (comandos do Plano B não contam)
AI_DAILY_LIMIT_PER_USER=50

# Cascata de custo zero: regex -> Qwen local -> Groq -> Cerebras -> (Gemini pago) -> (OpenAI)
AI_PROVIDER_ORDER=local,groq,cerebras,gemini,openai
# Qwen local (opcional): docker compose --profile local-llm ...; arquivo .gguf em ./models
LOCAL_LLM_URL=
LOCAL_LLM_MODEL_FILE=qwen3.5-2b-q4_k_m.gguf
LOCAL_LLM_THREADS=2
# Níveis gratuitos que não treinam com os dados (confirme os termos de uso comercial)
GROQ_API_KEY=
GROQ_DAILY_LIMIT=950
CEREBRAS_API_KEY=
CEREBRAS_DAILY_LIMIT=600
# Gemini só é usado com GEMINI_PAID_TIER=true (o nível gratuito treina com os dados)
GEMINI_API_KEY=
GEMINI_PAID_TIER=false
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
